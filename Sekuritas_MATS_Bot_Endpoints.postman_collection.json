			"name": "1. Sekuritas Internal API (x-service-token)",
			"item": [
				{
					"name": "Provision Bots (Create Account)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-service-token",
								"value": "{{sekuritas_bot_service_token}}",
								"type": "text"
							},
							{
								"key": "idempotency-key",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "x-correlation-id",
								"value": "{{$guid}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"bots\": [\n        {\n            \"external_bot_id\": \"bot-dev-noise-1\",\n            \"email\": \"bot-dev-noise-1@mandala.local\",\n            \"tier\": \"retail\",\n            \"strategy\": \"noise\"\n        },\n        {\n            \"external_bot_id\": \"bot-dev-noise-2\",\n            \"email\": \"bot-dev-noise-2@mandala.local\",\n            \"tier\": \"retail\",\n            \"strategy\": \"noise\"\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{sekuritas_base_url}}/bot/internal/provision",
							"host": [
								"{{sekuritas_base_url}}"
							],
							"path": [
								"bot",
								"internal",
								"provision"
							]
						},
						"description": "Pendaftaran massal akun bot tanpa email verification manual."
					},
					"response": []
				},
				{
					"name": "Get Operational Tokens",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson.tokens && responseJson.tokens.length > 0) {",
									"    pm.collectionVariables.set(\"bot_1_jwt_token\", responseJson.tokens[0].token);",
									"    pm.collectionVariables.set(\"bot_1_account_id\", responseJson.tokens[0].account_id);",
									"    if (responseJson.tokens[1]) {",
									"        pm.collectionVariables.set(\"bot_2_jwt_token\", responseJson.tokens[1].token);",
									"        pm.collectionVariables.set(\"bot_2_account_id\", responseJson.tokens[1].account_id);",
									"    }",
									"    console.log(\"Saved tokens to collection variables\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-service-token",
								"value": "{{sekuritas_bot_service_token}}",
								"type": "text"
							},
							{
								"key": "idempotency-key",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "x-correlation-id",
								"value": "{{$guid}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"account_ids\": [\n        \"{{bot_1_account_id}}\",\n        \"{{bot_2_account_id}}\"\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{sekuritas_base_url}}/bot/internal/tokens",
							"host": [
								"{{sekuritas_base_url}}"
							],
							"path": [
								"bot",
								"internal",
								"tokens"
							]
						},
						"description": "Menukarkan account_id dengan operational JWT Token."
					},
					"response": []
				},
				{
					"name": "Genesis Seeding Cash & Share",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-service-token",
								"value": "{{sekuritas_bot_service_token}}",
								"type": "text"
							},
							{
								"key": "idempotency-key",
								"value": "genesis-run-{{$timestamp}}",
								"type": "text"
							},
							{
								"key": "x-correlation-id",
								"value": "{{$guid}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"genesis_run_id\": \"{{$guid}}\",\n    \"accounts\": [\n        {\n            \"external_bot_id\": \"bot-dev-noise-1\",\n            \"account_id\": \"{{bot_1_account_id}}\",\n            \"cash_idr\": 100000000,\n            \"positions\": [\n                {\n                    \"symbol\": \"MNDL\",\n                    \"quantity_shares\": 5000,\n                    \"average_price_idr\": 316\n                },\n                {\n                    \"symbol\": \"BARA\",\n                    \"quantity_shares\": 10000,\n                    \"average_price_idr\": 190\n                }\n            ]\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{sekuritas_base_url}}/bot/internal/genesis",
							"host": [
								"{{sekuritas_base_url}}"
							],
							"path": [
								"bot",
								"internal",
								"genesis"
							]
						},
						"description": "Menambahkan saldo cash RDN dan posisi saham awal (seeding) untuk testing."
					},
					"response": []
				},
				{
					"name": "Portfolio Snapshot Bulk",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-service-token",
								"value": "{{sekuritas_bot_service_token}}",
								"type": "text"
							},
							{
								"key": "x-correlation-id",
