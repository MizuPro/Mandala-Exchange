						"description": "Membaca cash, portfolio, dan open orders dari akun-akun bot secara massal."
					},
					"response": []
				},
				{
					"name": "Account Event Stream (WS)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-service-token",
								"value": "{{sekuritas_bot_service_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "ws://localhost:3002/bot/internal/events/ws?after_sequence=0",
							"protocol": "ws",
							"host": [
								"localhost"
							],
							"port": "3002",
							"path": [
								"bot",
								"internal",
								"events",
								"ws"
							],
							"query": [
								{
									"key": "after_sequence",
									"value": "0"
								}
							]
						},
						"description": "Membuka koneksi WebSocket untuk streaming update portfolio & orders."
					},
					"response": []
				}
			]
		},
