						"body": {
							"mode": "raw",
							"raw": "{\n    \"account_ids\": [\n        \"{{bot_1_account_id}}\"\n    ],\n    \"include_open_orders\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{sekuritas_base_url}}/bot/internal/portfolio-snapshot",
