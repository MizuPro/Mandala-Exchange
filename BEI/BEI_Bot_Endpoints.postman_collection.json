    {
      "name": "News — Admin Endpoints",
      "item": [
        {
          "name": "1. Create News Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-service-token",
                "value": "{{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"MNDL Luncurkan Produk Baru\",\n  \"body\": \"Mandala Exchange meluncurkan produk robot trading pintar versi 2.0 yang diklaim sangat efisien.\",\n  \"symbol\": \"MNDL\",\n  \"sentiment\": \"positive\",\n  \"intensity\": \"high\",\n  \"simulationOnly\": false,\n  \"expirySession\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/news",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "news"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Update News Draft",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-service-token",
                "value": "{{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"MNDL Luncurkan Produk Baru v2.1\",\n  \"intensity\": \"extreme\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/news/{{newsId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "news",
                "{{newsId}}"
              ]
            }
