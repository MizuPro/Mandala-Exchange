    {
      "name": "Admin POST Endpoints",
      "item": [
        {
          "name": "1. Set Fair Value",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-service-token",
                "value": "{{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"MNDL\",\n  \"fairValue\": 1250,\n  \"confidence\": \"medium\",\n  \"method\": \"admin_estimate\",\n  \"notes\": \"Inisiasi harga wajar MNDL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bot/admin/fair-value",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bot",
                "admin",
                "fair-value"
              ]
            }
          },
          "response": []
        },
